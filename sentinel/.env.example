# Everything works without keys. These free keys unlock extra layers.

# Global ship tracking at every chokepoint (free): https://aisstream.io
AISSTREAM_API_KEY=

# Thermal anomalies / fires in conflict theatres (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Internet outages with cause (free token): https://dash.cloudflare.com/profile/api-tokens (Radar read)
CLOUDFLARE_API_TOKEN=

PORT=8080
